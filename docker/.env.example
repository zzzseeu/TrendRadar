# Web 服务端口
WEBSERVER_PORT=8080

# Docker 构建及容器运行时访问宿主机代理
DOCKER_PROXY_URL=http://host.docker.internal:7892
# 绕过代理直连的内网域名（逗号分隔）
DOCKER_NO_PROXY=apigw.hnaicc.cn,qyapi.weixin.qq.com

# 通知渠道（多账号用 ; 分隔）
FEISHU_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DINGTALK_WEBHOOK_URL=
WEWORK_WEBHOOK_URL=
WEWORK_MSG_TYPE=markdown
WEWORK_PDF_ENABLED=false
WEWORK_PDF_TOP_N=5

# 邮件
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# ntfy
NTFY_SERVER_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Bark、Slack 与通用 Webhook
BARK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_TEMPLATE=

# AI
AI_ANALYSIS_ENABLED=
AI_API_KEY=
AI_MODEL=
AI_API_BASE=

# Elsevier 全文 API 凭据（仅服务端使用，请勿提交真实值）
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# S3 兼容存储
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# 定时运行：每天北京时间 10:00
CRON_SCHEDULE="0 10 * * *"
RUN_MODE=cron
IMMEDIATE_RUN=false
